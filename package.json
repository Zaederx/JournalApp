{
  "name": "the-journal-app",
  "version": "4.5.0",
  "description": "",
  "main": "js/main.js",
  "scripts": {
    "bundle": "npm run scss && npm run tsc && npm run pack;",
    "pack": "webpack",
    "tsc": "tsc",
    "scss": "sass --no-source-map ./scss:./css",
    "scss-watch": "sass ./scss:./css --watch --no-source-map",
    "start": "electron-forge start",
    "run-all-start": "npm run bundle && npm start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "chromedriver": "chromedriver -h",
    "tsc-tests": "tsc -p ./test/tsconfig.mocha.json",
    "mocha": "mocha ./test/js/*.spec.mjs",
    "test":"npm run tsc-tests && npm run mocha"
  },
  "author": "Zachary Ishmael",
  "license": "ISC",
  "devDependencies": {
    "@electron-forge/cli": "^6.1.1",
    "@electron-forge/maker-deb": "^6.1.1",
    "@electron-forge/maker-rpm": "^6.1.1",
    "@electron-forge/maker-squirrel": "^6.1.1",
    "@electron-forge/maker-zip": "^6.1.1",
    "@types/adm-zip": "^0.5.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.3.3",
    "@types/nodemailer": "^6.4.7",
    "@types/pdfkit": "^0.12.8",
    "@types/uuid": "^9.0.1",
    "electron": "^13.6.9",
    "mocha": "^10.2.0",
    "sass": "^1.58.3",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "webpack": "^5.76.2",
    "webpack-cli": "^5.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "bcryptjs": "^2.4.3",
    "electron-squirrel-startup": "^1.0.0",
    "nodemailer": "^6.9.1",
    "pdfkit": "^0.13.0",
    "printformatted-js": "^1.0.4",
    "uuid": "^9.0.0"
  }
}
